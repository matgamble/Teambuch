{
  "name": "mp3-cover-tool",
  "version": "1.0.0",
  "description": "MP3-Cover-Tool für den MECHEN-Player, als Android-App verpackt (Capacitor)",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "smoke": "node tools/smoke-test.mjs www tools/testdaten .",
    "vendor": "cp node_modules/jszip/dist/jszip.min.js www/vendor/jszip.min.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "jszip": "^3.10.1"
  }
}
